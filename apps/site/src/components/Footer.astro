---
import { BRAND, TELEGRAM_BOT_URL } from '../lib/store';
---

<footer class="footer">
  <div class="wrap">
    <div class="cta card">
      <div>
        <h2>Prefer Telegram?</h2>
        <p>Browse the catalog, buy, and claim channel access inside our bot.</p>
      </div>
      <a class="btn btn-primary" href={TELEGRAM_BOT_URL} rel="noopener">Open the Telegram bot</a>
    </div>
    <div class="legal">
      <span class="brand">{BRAND}</span>
      <span>Payments in USDT on TRC20, processed by our checkout partner.</span>
      <span>Educational content only. Not financial advice.</span>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 24px 0 40px;
  }
  .cta {
    display: grid;
    gap: 24px;
    padding: clamp(28px, 5vw, 48px);
    background: var(--ink);
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .cta h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .cta p {
    margin-top: 8px;
    color: #c4cad8;
  }
  .cta :focus-visible {
    outline-color: var(--sun);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 32px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .brand {
    color: var(--ink);
    font-weight: 700;
  }
  @media (min-width: 760px) {
    .cta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
