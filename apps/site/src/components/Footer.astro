---
import { BRAND, TELEGRAM_BOT_URL } from '../lib/store';
---

<footer class="footer">
  <div class="wrap grid">
    <div>
      <p class="brand">{BRAND}</p>
      <p class="small">[ONE-LINE FOOTER DESCRIPTION]</p>
    </div>
    <div class="cta">
      <p class="small">Browse and buy inside Telegram, and claim channel access there.</p>
      <a class="btn" href={TELEGRAM_BOT_URL} rel="noopener">Open the Telegram bot</a>
    </div>
  </div>
  <div class="wrap legal small">
    <span>© {new Date().getFullYear()} {BRAND}</span>
    <span>Payments in USDT on TRC20, processed by our checkout partner.</span>
    <span>Educational content only. Not financial advice.</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--green-deep);
    color: var(--on-green);
    padding: calc(var(--u) * 8) 0 calc(var(--u) * 4);
  }
  .grid {
    display: grid;
    gap: calc(var(--u) * 4);
  }
  .brand {
    font: 600 2rem/1 var(--font-display);
    margin-bottom: var(--u);
  }
  .small {
    color: var(--on-green-muted);
    font-size: 0.95rem;
  }
  .cta {
    display: grid;
    gap: calc(var(--u) * 2);
    justify-items: start;
  }
  .btn {
    background: var(--paper);
    color: var(--green);
    border-color: var(--paper);
  }
  .btn:hover {
    background: #fff;
  }
  :focus-visible {
    outline-color: var(--uv-ink);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--u) calc(var(--u) * 3);
    margin-top: calc(var(--u) * 6);
    padding-top: calc(var(--u) * 2.5);
    border-top: 1px solid rgb(233 237 226 / 0.25);
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .cta {
      justify-items: end;
      text-align: right;
    }
  }
</style>
