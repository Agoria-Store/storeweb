---
import { TELEGRAM_BOT_URL } from '../lib/store';
const faqs = [
  { q: 'Can I get a refund?', a: '[Refund policy, to be confirmed.]' },
  {
    q: 'What if I send on the wrong network?',
    a: 'Only USDT on TRC20 is accepted. Payments on other networks may not be detected automatically. Message us with your order ID and transaction hash, and we will review it by hand. [Wrong-network policy, to be confirmed.]',
  },
  {
    q: 'How long does confirmation take?',
    a: 'Your course is sent once the payment is confirmed on the Tron network. [Typical confirmation time, to be confirmed with the checkout platform.]',
  },
  {
    q: 'How are the files delivered?',
    a: 'Either by an expiring download link or a one-time invite to a private Telegram channel. Each course page shows which one applies.',
  },
  {
    q: 'What if I send too little or too much?',
    a: 'Send the exact amount shown at checkout. If the amount is different, message us with your order ID. [Underpayment and overpayment policy, to be confirmed.]',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. The courses are educational. Trading crypto carries risk, and nothing here promises profits.',
  },
];
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <div class="wrap layout">
    <div>
      <h2 id="faq-title" class="h2">Questions before you pay</h2>
      <p class="lede">
        Something else? <a href={TELEGRAM_BOT_URL}>Ask us on Telegram</a>.
      </p>
    </div>
    <div class="list">
      {
        faqs.map((f) => (
          <details>
            <summary>
              {f.q}
              <span class="plus" aria-hidden="true" />
            </summary>
            <div class="panel">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initAccordion } from '../scripts/accordion';
  initAccordion(document.querySelector('#faq')!);
</script>

<style>
  .faq {
    padding-block: clamp(80px, 11vw, 136px) clamp(48px, 7vw, 80px);
  }
  .layout {
    display: grid;
    gap: 40px;
  }
  .lede a {
    display: inline-block;
    padding-block: 6px;
    color: var(--primary);
    font-weight: 600;
  }
  .list {
    display: grid;
    gap: 10px;
  }
  details {
    border-radius: 14px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: box-shadow 0.3s var(--ease);
  }
  details[open] {
    box-shadow: var(--shadow-lg);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 20px 22px;
    font-weight: 600;
    font-size: 1.05rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--primary);
  }
  .plus {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 6px 0 auto;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  details[open] .plus::after {
    transform: rotate(0deg);
  }
  .panel {
    padding: 0 22px 22px;
    color: var(--muted);
    max-width: 66ch;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
