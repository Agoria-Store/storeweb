---
import type { Product } from '@course-store/store-client';
interface Props {
  product: Product;
  size?: 'sm' | 'lg';
}
const { product: p, size = 'sm' } = Astro.props;
---

<div class={`specimen ${size}`}>
  {
    p.thumbnailUrl ? (
      <img src={p.thumbnailUrl} alt="" width="640" height="400" loading="lazy" decoding="async" />
    ) : (
      <span class="den num" aria-hidden="true">
        {p.priceUsdt}
      </span>
    )
  }
  {
    p.previewUrl && (
      <>
        <video muted loop playsinline preload="none" data-src={p.previewUrl} aria-hidden="true" />
        <button class="play" type="button" data-preview-toggle aria-pressed="false">
          <span class="sr-only">Play preview of {p.title}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3 1.5v11l9-5.5z" fill="currentColor" />
          </svg>
        </button>
      </>
    )
  }
</div>

<style>
  .specimen {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1.5px solid var(--green);
    outline: 1px solid var(--green);
    outline-offset: -5px;
    background:
      repeating-radial-gradient(
        circle at 78% 50%,
        transparent 0 5px,
        rgb(95 163 155 / 0.35) 5px 6px
      ),
      var(--paper);
  }
  .lg {
    outline-offset: -9px;
  }
  .den {
    position: absolute;
    right: 10%;
    top: 50%;
    translate: 0 -50%;
    font-size: 2rem;
    color: var(--green);
    background: var(--paper);
    padding: 0 4px;
    line-height: 1;
  }
  .lg .den {
    font-size: clamp(3rem, 8vw, 5rem);
  }
  img,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  video {
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.is-previewing) video {
    opacity: 1;
  }
  .play {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--green);
    color: var(--paper);
    cursor: pointer;
  }
</style>
