---
import type { Product } from '@course-store/store-client';
import Illustration from './Illustration.astro';
import type { Art } from '../lib/art';
interface Props {
  product: Product;
  art: Art;
  number?: number;
  eager?: boolean;
}
const { product: p, art, number, eager = false } = Astro.props;
---

<div class="thumb">
  {
    p.thumbnailUrl ? (
      <img
        src={p.thumbnailUrl}
        alt=""
        width="640"
        height="400"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <Illustration art={art} number={number} />
    )
  }
  {
    p.previewUrl && (
      <>
        <video muted loop playsinline preload="none" data-src={p.previewUrl} aria-hidden="true" />
        <button class="play" type="button" data-preview-toggle aria-pressed="false">
          <span class="sr-only">Play preview of {p.title}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3 1.5v11l9-5.5z" fill="currentColor" />
          </svg>
        </button>
      </>
    )
  }
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
  }
  img,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  video {
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.is-previewing) video {
    opacity: 1;
  }
  .play {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
</style>
