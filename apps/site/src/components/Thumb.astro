---
import type { Product } from '@course-store/store-client';
interface Props {
  product: Product;
  eager?: boolean;
}
const { product: p, eager = false } = Astro.props;
const palettes = [
  ['#5b3df5', '#ff7ac6', '#ffd23f'],
  ['#0e8f63', '#5eead4', '#5b3df5'],
  ['#ff7ac6', '#ffd23f', '#5eead4'],
];
const seed = [...p.id].reduce((a, c) => a + c.charCodeAt(0), 0);
const [a, b, c] = palettes[seed % palettes.length]!;
---

<div class="thumb" style={`--a:${a};--b:${b};--c:${c}`}>
  {
    p.thumbnailUrl ? (
      <img
        src={p.thumbnailUrl}
        alt=""
        width="640"
        height="400"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <span class="ph" aria-hidden="true">
        [Thumbnail]
      </span>
    )
  }
  {
    p.previewUrl && (
      <>
        <video muted loop playsinline preload="none" data-src={p.previewUrl} aria-hidden="true" />
        <button class="play" type="button" data-preview-toggle aria-pressed="false">
          <span class="sr-only">Play preview of {p.title}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M3 1.5v11l9-5.5z" fill="currentColor" />
          </svg>
        </button>
      </>
    )
  }
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    background:
      radial-gradient(70% 90% at 20% 15%, var(--b), transparent 65%),
      radial-gradient(60% 80% at 90% 90%, var(--c), transparent 60%), var(--a);
  }
  img,
  video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  video {
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(.is-previewing) video {
    opacity: 1;
  }
  .ph {
    position: absolute;
    right: 12px;
    bottom: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.85);
  }
  .play {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
</style>
