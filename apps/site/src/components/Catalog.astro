---
import type { ProductType } from '@course-store/store-client';
import { store } from '../lib/store';
import { withSavings, TYPE_LABEL } from '../lib/catalog';
import CourseCard from './CourseCard.astro';

const s = await store();
const products = await Promise.all((await s.listProducts()).map(withSavings));
const types = [...new Set(products.map((p) => p.type))] as ProductType[];
const DEFAULT = types.includes('course') ? 'course' : 'all';
---

<section id="courses" class="section" aria-labelledby="courses-title">
  <div class="wrap">
    <div class="head">
      <div>
        <h2 id="courses-title" class="h2">Buy the whole course, or only what you need</h2>
        <p class="lede">
          Every course is also sold chapter by chapter. The full course always costs less than its
          chapters added together.
        </p>
      </div>
      <div class="filters" role="group" aria-label="Show" data-filters>
        {
          ['all', ...types].map((t) => (
            <button type="button" data-filter={t} aria-pressed={t === DEFAULT ? 'true' : 'false'}>
              {t === 'all' ? 'Everything' : `${TYPE_LABEL[t as ProductType]}s`}
            </button>
          ))
        }
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <ul class="ledger" data-grid data-default={DEFAULT}>
      {products.map((p) => <CourseCard product={p} />)}
    </ul>
  </div>
</section>

<script>
  import { initCatalog } from '../scripts/catalog';
  initCatalog();
</script>

<style>
  .head {
    display: grid;
    gap: calc(var(--u) * 4);
    margin-bottom: calc(var(--u) * 5);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 3);
    justify-self: start;
    align-self: end;
  }
  .filters button {
    min-height: 44px;
    padding: 0 2px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    color: var(--muted);
    font: 700 1rem/1 var(--font-body);
    cursor: pointer;
  }
  .filters button:hover {
    color: var(--ink);
  }
  .filters button[aria-pressed='true'] {
    color: var(--green);
    border-bottom-color: var(--red);
  }
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .ledger :global([data-card][hidden]) {
    display: none;
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1fr auto;
    }
  }
</style>
