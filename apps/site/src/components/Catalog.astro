---
import type { ProductType } from '@course-store/store-client';
import { store } from '../lib/store';
import { withSavings, TYPE_LABEL } from '../lib/catalog';
import CourseCard from './CourseCard.astro';

const s = await store();
const products = await Promise.all((await s.listProducts()).map(withSavings));
const types = [...new Set(products.map((p) => p.type))] as ProductType[];
const DEFAULT = types.includes('course') ? 'course' : 'all';
---

<section id="courses" class="section" aria-labelledby="courses-title">
  <div class="wrap">
    <div class="head">
      <div>
        <h2 id="courses-title" class="h2">Buy the whole course, or only what you need</h2>
        <p class="lede">
          Every course is also sold chapter by chapter. The full course always costs less than its
          chapters added together.
        </p>
      </div>
      <div class="filters" role="group" aria-label="Filter products" data-filters>
        {
          ['all', ...types].map((t) => (
            <button type="button" data-filter={t} aria-pressed={t === DEFAULT ? 'true' : 'false'}>
              {t === 'all' ? 'All' : `${TYPE_LABEL[t as ProductType]}s`}
            </button>
          ))
        }
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <ul class="grid" data-grid data-default={DEFAULT}>
      {products.map((p) => <CourseCard product={p} />)}
    </ul>
  </div>
</section>

<script>
  import { initCatalog } from '../scripts/catalog';
  initCatalog();
</script>

<style>
  .head {
    display: grid;
    gap: 28px;
    margin-bottom: 40px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface-2);
    justify-self: start;
    align-self: end;
  }
  .filters button {
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: 600 0.9rem/1 var(--font);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }
  .filters button:hover {
    color: var(--ink);
  }
  .filters button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 3px rgb(18 24 38 / 0.12);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
  }
  .grid :global([data-card][hidden]) {
    display: none;
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1fr auto;
    }
  }
</style>
