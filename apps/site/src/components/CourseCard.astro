---
import { formatUsdt } from '@course-store/store-client';
import { productHref, TYPE_LABEL, type Listed } from '../lib/catalog';
import Thumb from './Thumb.astro';

interface Props {
  product: Listed;
}
const { product: p } = Astro.props;
const unit = p.type === 'bundle' ? 'products' : 'chapters';
const kind = [TYPE_LABEL[p.type], p.childCount > 0 ? `${p.childCount} ${unit}` : null]
  .filter(Boolean)
  .join(' · ');
const delivery = p.delivery === 'telegram_channel' ? 'Telegram channel' : 'Download';
---

<li class="item card" data-card data-type={p.type}>
  <Thumb product={p} />
  <div class="body">
    <p class="kind">{kind}</p>
    <h3><a href={productHref(p)} class="stretched">{p.title}</a></h3>
    <p class="desc">{p.description}</p>
    <div class="foot">
      <span class="price amount">{formatUsdt(p.priceUsdt)}</span>
      {p.savings > 0 && <span class="badge-save">Save {p.savings}%</span>}
    </div>
    <p class="delivery">{delivery}</p>
  </div>
</li>

<style>
  .item {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 10px;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .item:hover,
  .item:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .body {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 10px 10px;
  }
  .kind {
    font-size: 0.85rem;
    color: var(--muted);
  }
  h3 {
    font-size: 1.35rem;
    letter-spacing: -0.025em;
  }
  .stretched {
    text-decoration: none;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .desc {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .foot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }
  .amount {
    font-size: 1.25rem;
  }
  .delivery {
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
