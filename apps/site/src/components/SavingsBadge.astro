---
import { formatUsdt } from '@course-store/store-client';
interface Props {
  percent: number;
  partsTotal: number;
  price: number;
  label: string;
}
const { percent, partsTotal, price, label } = Astro.props;
---

{
  percent > 0 && (
    <div class="badge" role="note">
      <span class="pct">
        Save <span data-count={percent}>{percent}</span>%
      </span>
      <span class="calc">
        {label}: <s>{formatUsdt(partsTotal)}</s> → <span class="money">{formatUsdt(price)}</span>
      </span>
    </div>
  )
}

<style>
  .badge {
    position: relative;
    display: inline-grid;
    gap: 4px;
    padding: 14px 18px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgb(245 158 11 / 0.16), rgb(245 158 11 / 0.04));
    border: 1px solid rgb(245 158 11 / 0.35);
    overflow: hidden;
  }
  .badge::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.14), transparent 70%);
    transform: translateX(-100%);
    animation: sheen 3.2s 1s var(--ease) infinite;
  }
  .pct {
    font: 700 1.6rem/1 var(--font-head);
    color: var(--amber);
    font-variant-numeric: tabular-nums;
  }
  .calc {
    color: var(--muted);
    font-size: 0.85rem;
  }
  s {
    opacity: 0.8;
  }
  @keyframes sheen {
    60%,
    100% {
      transform: translateX(100%);
    }
  }
</style>
