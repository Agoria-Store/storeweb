---
import { store } from '../lib/store';
import { productHref } from '../lib/catalog';

// Set when the free-chapter video exists under /public/media.
const freeVideo = null as null | { src: string; poster: string; captions?: string };
const course = (await (await store()).listProducts({ type: 'course' }))[0];
---

<section id="free-chapter" class="section free" aria-labelledby="free-title">
  <div class="wrap layout">
    <div class="copy">
      <p class="eyebrow" data-reveal>Free chapter</p>
      <h2 id="free-title" class="h2" data-reveal>Watch a full chapter before you pay.</h2>
      <p class="lede" data-reveal>
        [FREE CHAPTER PITCH — what's covered and why it's worth watching.]
      </p>
      {
        course && (
          <a class="btn btn-ghost" href={productHref(course)} data-reveal>
            See the full course →
          </a>
        )
      }
    </div>
    <div class="player" data-reveal>
      {
        freeVideo ? (
          <video
            controls
            playsinline
            preload="none"
            poster={freeVideo.poster}
            width="1280"
            height="720"
          >
            <source src={freeVideo.src} type="video/mp4" />
            {freeVideo.captions && (
              <track kind="captions" src={freeVideo.captions} srclang="en" default />
            )}
          </video>
        ) : (
          <div class="ph">
            <span class="play" aria-hidden="true">
              ▶
            </span>
            <span>[FREE CHAPTER VIDEO]</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .free {
    background: linear-gradient(180deg, var(--bg), var(--bg-2));
  }
  .layout {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .copy .btn {
    margin-top: 22px;
  }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
    box-shadow: 0 40px 80px -40px rgb(45 212 191 / 0.35);
  }
  video {
    width: 100%;
    height: 100%;
  }
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 14px;
    color: var(--muted);
    font: 600 0.8rem/1 var(--font-head);
    letter-spacing: 0.1em;
    background: radial-gradient(60% 70% at 50% 40%, rgb(45 212 191 / 0.16), transparent 70%);
  }
  .play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--teal);
    color: #04201d;
    font-size: 1.4rem;
    box-shadow: 0 0 0 10px rgb(45 212 191 / 0.15);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }
</style>
