---
import { store } from '../lib/store';
import { productHref } from '../lib/catalog';

// Set when the free-chapter video exists under /public/media.
const freeVideo = null as null | { src: string; poster: string; captions?: string };
const course = (await (await store()).listProducts({ type: 'course' }))[0];
---

<section id="free-chapter" class="section free" aria-labelledby="free-title">
  <div class="wrap layout">
    <div class="copy">
      <h2 id="free-title" class="h2">Watch a full chapter before you pay</h2>
      <p class="lede">[What the free chapter covers, in one or two plain sentences.]</p>
      {
        course && (
          <a class="btn btn-secondary" href={productHref(course)}>
            See every chapter of {course.title}
          </a>
        )
      }
    </div>
    <div class="player frame">
      {
        freeVideo ? (
          <video
            controls
            playsinline
            preload="none"
            poster={freeVideo.poster}
            width="1280"
            height="720"
          >
            <source src={freeVideo.src} type="video/mp4" />
            {freeVideo.captions && (
              <track kind="captions" src={freeVideo.captions} srclang="en" default />
            )}
          </video>
        ) : (
          <div class="ph">
            <span class="play" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 14 14">
                <path d="M3 1.5v11l9-5.5z" fill="currentColor" />
              </svg>
            </span>
            <span>[Free chapter video goes here]</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .free {
    background: var(--paper-deep);
  }
  .layout {
    display: grid;
    gap: calc(var(--u) * 5);
    align-items: center;
  }
  .copy {
    display: grid;
    justify-items: start;
  }
  .copy .btn {
    margin-top: calc(var(--u) * 4);
  }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    padding: 10px;
  }
  video {
    width: 100%;
    height: 100%;
  }
  .ph {
    position: absolute;
    inset: 10px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: calc(var(--u) * 2);
    color: var(--on-green-muted);
    background: var(--green-deep);
  }
  .play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--green);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
