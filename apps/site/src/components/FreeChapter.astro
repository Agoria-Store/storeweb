---
import { store } from '../lib/store';
import { productHref } from '../lib/catalog';

// Set when the free-chapter video exists under /public/media.
const freeVideo = null as null | { src: string; poster: string; captions?: string };
const course = (await (await store()).listProducts({ type: 'course' }))[0];
const courseHref = course ? await productHref(course) : '#courses';
---

<section id="free-chapter" class="section" aria-labelledby="free-title">
  <div class="wrap layout">
    <div class="copy">
      <h2 id="free-title" class="h2">Watch a full chapter before you pay</h2>
      <p class="lede">[What the free chapter covers, in one or two plain sentences.]</p>
      {
        course && (
          <a class="btn btn-secondary" href={courseHref}>
            See all chapters of {course.title}
          </a>
        )
      }
    </div>
    <div class="player">
      {
        freeVideo ? (
          <video
            controls
            playsinline
            preload="none"
            poster={freeVideo.poster}
            width="1280"
            height="720"
          >
            <source src={freeVideo.src} type="video/mp4" />
            {freeVideo.captions && (
              <track kind="captions" src={freeVideo.captions} srclang="en" default />
            )}
          </video>
        ) : (
          <div class="ph">
            <span class="play" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 14 14">
                <path d="M3 1.5v11l9-5.5z" fill="currentColor" />
              </svg>
            </span>
            <span>[Free chapter video goes here]</span>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .copy {
    display: grid;
    justify-items: start;
  }
  .copy .btn {
    margin-top: 28px;
  }
  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 20px;
    background: var(--ink);
    box-shadow: var(--shadow-lg);
  }
  video {
    width: 100%;
    height: 100%;
  }
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 16px;
    color: #c4cad8;
    background:
      radial-gradient(60% 80% at 20% 0%, rgb(200 144 46 / 0.55), transparent 60%),
      radial-gradient(50% 70% at 100% 100%, rgb(231 201 138 / 0.35), transparent 60%), var(--ink);
  }
  .play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
