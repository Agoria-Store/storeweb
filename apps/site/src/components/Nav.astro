---
import { BRAND, TELEGRAM_BOT_URL } from '../lib/store';
const home = Astro.url.pathname === '/';
const base = home ? '' : '/';
---

<header class="nav" data-nav>
  <div class="wrap row">
    <a class="logo" href="/" aria-current={home ? 'page' : undefined}>
      <img src="/favicon.svg" width="28" height="28" alt="" />
      <span>{BRAND}</span>
    </a>
    <nav aria-label="Primary">
      <a class="link" href={`${base}#courses`}>Courses</a>
      <a class="link wide" href={`${base}#pay`}>How to pay</a>
      <a class="link wide" href={`${base}#faq`}>FAQ</a>
      <a class="btn btn-secondary tg" href={TELEGRAM_BOT_URL}>Telegram bot</a>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    transition: box-shadow 0.3s;
  }
  .nav.scrolled {
    box-shadow: 0 1px 0 var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .logo {
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    font-size: 1rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .link {
    padding: 10px 0;
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .link:hover {
    color: var(--ink);
  }
  .wide {
    display: none;
  }
  .tg {
    white-space: nowrap;
    min-height: 38px;
    padding: 0 14px;
    font-size: 0.875rem;
  }
  @media (min-width: 760px) {
    nav {
      gap: 32px;
    }
    .wide {
      display: inline;
    }
  }
</style>
