---
import { BRAND, TELEGRAM_BOT_URL } from '../lib/store';
const base = Astro.url.pathname === '/' ? '' : '/';
---

<header class="nav" data-nav>
  <div class="wrap row">
    <a class="logo" href="/">
      <img src="/favicon.svg" width="28" height="28" alt="" />
      <span>{BRAND}</span>
    </a>
    <nav aria-label="Primary">
      <a class="link" href={`${base}#courses`}>Courses</a>
      <a class="link" href={`${base}#pay`}>How to pay</a>
      <a class="link" href={`${base}#faq`}>FAQ</a>
      <a class="btn btn-dark tg" href={TELEGRAM_BOT_URL} rel="noopener">Telegram bot</a>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .nav.scrolled {
    background: var(--surface);
    box-shadow: 0 1px 0 var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .link {
    display: none;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
  }
  .link:hover {
    color: var(--primary);
  }
  .tg {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.9rem;
  }
  @media (min-width: 760px) {
    .link {
      display: inline;
    }
  }
</style>
