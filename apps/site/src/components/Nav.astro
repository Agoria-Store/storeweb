---
import { BRAND, TELEGRAM_BOT_URL } from '../lib/store';
const base = Astro.url.pathname === '/' ? '' : '/';
---

<header class="nav">
  <div class="wrap row">
    <a class="logo" href="/">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <circle cx="16" cy="16" r="8" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <circle cx="16" cy="16" r="2.5" fill="var(--red)"></circle>
      </svg>
      <span>{BRAND}</span>
    </a>
    <nav aria-label="Primary">
      <a href={`${base}#courses`}>Courses</a>
      <a href={`${base}#pay`}>How to pay</a>
      <a href={`${base}#faq`}>Questions</a>
      <a class="tg" href={TELEGRAM_BOT_URL} rel="noopener">Telegram bot</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--green);
    font: 700 1.2rem/1 var(--font-display);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.95rem;
  }
  nav a:hover {
    text-decoration: underline;
  }
  nav a:not(.tg) {
    display: none;
  }
  .tg {
    padding: 10px 14px;
    border: 1.5px solid var(--green);
    border-radius: 4px;
    color: var(--green);
    font-weight: 700;
  }
  .tg:hover {
    background: var(--paper-deep);
    text-decoration: none;
  }
  @media (min-width: 760px) {
    nav a:not(.tg) {
      display: inline;
    }
  }
</style>
