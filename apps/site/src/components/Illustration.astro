---
import type { Art } from '../lib/art';
interface Props {
  art: Art;
  /** Set for chapters and videos: renders a quieter numbered tile instead of the full scene. */
  number?: number;
}
const { art, number } = Astro.props;

// Deterministic candle data so builds are stable.
const candles = Array.from({ length: 13 }, (_, i) => {
  const base = 120 - i * 5 + Math.sin(i * 1.7) * 14;
  const open = base + Math.cos(i * 2.3) * 9;
  const close = base - Math.sin(i * 1.1) * 11;
  return {
    x: 34 + i * 20,
    open,
    close,
    hi: Math.min(open, close) - 9,
    lo: Math.max(open, close) + 8,
  };
});
const trend = candles
  .map((c, i) => `${i ? 'L' : 'M'}${c.x} ${((c.open + c.close) / 2).toFixed(1)}`)
  .join(' ');
const bg = { candles: '#eef1ff', network: '#e8f6f0', wave: '#fff0f6', layers: '#fff6dc' }[art];
const nodes = [0, 1, 2, 3, 4, 5].map((i) => {
  const a = (i / 6) * Math.PI * 2 + 0.4;
  const r = i % 2 ? 78 : 52;
  return { x: 160 + Math.cos(a) * r * 1.25, y: 100 + Math.sin(a) * r * 0.62 };
});
---

{
  number !== undefined ? (
    <svg class="art" viewBox="0 0 320 200" aria-hidden="true">
      <rect width="320" height="200" fill="#f1f3f8" />
      <text x="24" y="176" class="num">
        {String(number).padStart(2, '0')}
      </text>
      {art === 'candles' &&
        candles.slice(4, 9).map((c, i) => (
          <g transform="translate(110 -10)">
            <line x1={c.x} x2={c.x} y1={c.hi} y2={c.lo} stroke="#9aa3b5" stroke-width="2" />
            <rect
              x={c.x - 6}
              y={Math.min(c.open, c.close)}
              width="12"
              height={Math.max(Math.abs(c.open - c.close), 4)}
              rx="2"
              fill={i === 4 ? '#5b3df5' : c.close < c.open ? '#26a17b' : '#c5cbd8'}
            />
          </g>
        ))}
      {art !== 'candles' && (
        <g fill="none" stroke-width="2">
          <ellipse cx="250" cy="70" rx="44" ry="20" stroke="#c5cbd8" />
          <ellipse cx="250" cy="70" rx="26" ry="11" stroke="#c5cbd8" />
          <circle cx="250" cy="70" r="9" fill="#26a17b" stroke="none" />
          <circle cx="294" cy="70" r="5" fill="#5b3df5" stroke="none" />
        </g>
      )}
    </svg>
  ) : (
    <svg class="art" viewBox="0 0 320 200" aria-hidden="true">
      <rect width="320" height="200" fill={bg} />
      {art === 'candles' && (
        <g>
          {[50, 90, 130, 170].map((y) => (
            <line x1="20" x2="300" y1={y} y2={y} stroke="#d8dcf3" stroke-width="1" />
          ))}
          {candles.map((c) => (
            <g>
              <line x1={c.x} x2={c.x} y1={c.hi} y2={c.lo} stroke="#7b84a3" stroke-width="2" />
              <rect
                x={c.x - 6}
                y={Math.min(c.open, c.close)}
                width="12"
                height={Math.max(Math.abs(c.open - c.close), 4)}
                rx="2"
                fill={c.close < c.open ? '#26a17b' : '#e8577a'}
              />
            </g>
          ))}
          <path d={trend} fill="none" stroke="#5b3df5" stroke-width="3" stroke-linecap="round" />
          <g transform="translate(222 26)">
            <rect width="74" height="28" rx="14" fill="#fff" />
            <circle cx="16" cy="14" r="7" fill="#26a17b" />
            <rect x="29" y="11" width="34" height="6" rx="3" fill="#121826" />
          </g>
        </g>
      )}
      {art === 'network' && (
        <g>
          <ellipse
            cx="160"
            cy="100"
            rx="122"
            ry="66"
            fill="none"
            stroke="#bfe5d6"
            stroke-width="2"
          />
          <ellipse
            cx="160"
            cy="100"
            rx="80"
            ry="42"
            fill="none"
            stroke="#bfe5d6"
            stroke-width="2"
          />
          {nodes.map((n, i) => (
            <g>
              <line x1="160" y1="100" x2={n.x} y2={n.y} stroke="#9fd8c2" stroke-width="1.5" />
              <circle
                cx={n.x}
                cy={n.y}
                r={i % 2 ? 10 : 7}
                fill={i % 3 === 0 ? '#5b3df5' : '#fff'}
                stroke="#26a17b"
                stroke-width="2"
              />
            </g>
          ))}
          <circle cx="160" cy="100" r="30" fill="#26a17b" />
          <rect x="146" y="86" width="28" height="7" rx="2" fill="#f3fff9" />
          <rect x="156" y="90" width="8" height="24" rx="2" fill="#f3fff9" />
        </g>
      )}
      {art === 'wave' && (
        <g fill="none" stroke-linecap="round">
          {[0, 1, 2, 3, 4].map((i) => (
            <path
              d={`M-10 ${150 - i * 18} C 70 ${70 - i * 10}, 140 ${190 - i * 14}, 220 ${110 - i * 12} S 330 ${60 - i * 6}, 340 ${70 - i * 8}`}
              stroke={['#5b3df5', '#ff7ac6', '#ffb35c', '#26a17b', '#121826'][i]}
              stroke-width={i === 0 ? 4 : 2}
              opacity={i === 0 ? 1 : 0.55}
            />
          ))}
          <circle cx="220" cy="110" r="8" fill="#fff" stroke="#5b3df5" stroke-width="3" />
        </g>
      )}
      {art === 'layers' && (
        <g>
          {[
            ['#5b3df5', 0],
            ['#ff7ac6', 1],
            ['#26a17b', 2],
          ].map(([c, i]) => (
            <g transform={`translate(0 ${-(i as number) * 26})`}>
              <path d="M160 168 L250 128 L160 88 L70 128 Z" fill={c as string} opacity="0.95" />
              <path d="M70 128 L70 138 L160 178 L160 168 Z" fill="#121826" opacity="0.18" />
              <path d="M250 128 L250 138 L160 178 L160 168 Z" fill="#121826" opacity="0.28" />
            </g>
          ))}
        </g>
      )}
    </svg>
  )
}

<style>
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .num {
    font: 600 84px/1 var(--font);
    letter-spacing: -0.05em;
    fill: #121826;
  }
</style>
