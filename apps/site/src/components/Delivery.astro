---
const options = [
  {
    key: 'download',
    title: 'Download link',
    body: 'After payment you get a private link to download the files. The link expires and allows a limited number of downloads, so save your files once you have them.',
    points: ['Keep the files', 'Watch offline', 'Link expires after [EXPIRY TIME]'],
  },
  {
    key: 'telegram',
    title: 'Private Telegram channel',
    body: 'After payment, send your order ID to our Telegram bot. It replies with a one-time invite to the course channel that only you can use.',
    points: ['Watch inside Telegram', 'Invite works once', 'New lessons posted in the channel'],
  },
];
---

<section class="section" aria-labelledby="delivery-title">
  <div class="wrap">
    <h2 id="delivery-title" class="h2">How you receive the course</h2>
    <p class="lede">Each course page says which of the two it uses.</p>
    <div class="grid">
      {
        options.map((o) => (
          <article class={`opt card ${o.key}`}>
            <span class="icon" aria-hidden="true">
              {o.key === 'download' ? (
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M12 3v12M7 10l5 5 5-5M5 21h14" />
                </svg>
              ) : (
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M21 4 3 11l6 2 2 6 3-4 5 4z" />
                </svg>
              )}
            </span>
            <h3>{o.title}</h3>
            <p>{o.body}</p>
            <ul>
              {o.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 20px;
    margin-top: 40px;
  }
  .opt {
    --c: var(--primary);
    --soft: var(--primary-soft);
    display: grid;
    gap: 12px;
    align-content: start;
    padding: 32px;
  }
  .opt.telegram {
    --c: var(--tg);
    --soft: var(--tg-soft);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--soft);
    color: var(--c);
  }
  h3 {
    margin-top: 8px;
    font-size: 1.5rem;
  }
  p {
    color: var(--muted);
  }
  ul {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 8px 0 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: 10px;
    align-items: center;
    font-weight: 500;
  }
  li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
