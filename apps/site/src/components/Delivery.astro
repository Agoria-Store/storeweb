---
const options = [
  {
    title: 'Download link',
    body: 'After payment you get a private link to download the files. The link expires and allows a limited number of downloads, so save your files once you have them.',
    points: ['Keep the files', 'Watch offline', 'Link expires after [EXPIRY TIME]'],
  },
  {
    title: 'Private Telegram channel',
    body: 'After payment, send your order ID to our Telegram bot. It replies with a one-time invite to the course channel that only you can use.',
    points: ['Watch inside Telegram', 'Invite works once', 'New lessons posted in the channel'],
  },
];
---

<section class="section" aria-labelledby="delivery-title">
  <div class="wrap">
    <h2 id="delivery-title" class="h2">How you receive the course</h2>
    <p class="lede">Each course page says which of the two it uses.</p>
    <div class="stubs">
      {
        options.map((o) => (
          <article class="stub">
            <h3>{o.title}</h3>
            <p>{o.body}</p>
            <ul>
              {o.points.map((pt) => (
                <li>{pt}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stubs {
    display: grid;
    margin-top: calc(var(--u) * 5);
    border: 2px solid var(--green);
  }
  .stub {
    display: grid;
    gap: calc(var(--u) * 1.5);
    align-content: start;
    padding: calc(var(--u) * 4);
  }
  /* Perforation between the two stubs. */
  .stub + .stub {
    border-top: 2px dotted var(--green);
  }
  h3 {
    font-size: 1.9rem;
    color: var(--green);
  }
  p {
    color: var(--muted);
    max-width: 52ch;
  }
  ul {
    display: grid;
    gap: 6px;
    padding: 0;
    margin: var(--u) 0 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: var(--u);
    align-items: baseline;
  }
  li::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--red);
    border-radius: 50%;
    translate: 0 -1px;
  }
  @media (min-width: 760px) {
    .stubs {
      grid-template-columns: 1fr 1fr;
    }
    .stub + .stub {
      border-top: 0;
      border-left: 2px dotted var(--green);
    }
  }
</style>
