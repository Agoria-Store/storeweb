---
// Static coin drawn to match the WebGL coin; shown first and kept when 3D cannot run.
---

<svg class="coin-svg" viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <radialGradient id="coin-face" cx="38%" cy="32%" r="75%">
      <stop offset="0" stop-color="#5fd3ab"></stop>
      <stop offset="0.55" stop-color="#26a17b"></stop>
      <stop offset="1" stop-color="#136b50"></stop>
    </radialGradient>
    <linearGradient id="coin-rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#9ff0d3"></stop>
      <stop offset="0.5" stop-color="#1e8c6a"></stop>
      <stop offset="1" stop-color="#0d5a43"></stop>
    </linearGradient>
  </defs>
  <circle cx="100" cy="100" r="92" fill="url(#coin-rim)"></circle>
  <circle cx="100" cy="100" r="80" fill="url(#coin-face)"></circle>
  <g fill="#f3fff9">
    <rect x="58" y="58" width="84" height="18" rx="2"></rect>
    <rect x="89" y="70" width="22" height="76" rx="2"></rect>
  </g>
  <ellipse cx="100" cy="94" rx="38" ry="11" fill="none" stroke="#f3fff9" stroke-width="6"></ellipse>
  <ellipse cx="78" cy="60" rx="40" ry="18" fill="#fff" opacity="0.12" transform="rotate(-25 78 60)"
  ></ellipse>
</svg>

<style>
  .coin-svg {
    width: 100%;
    height: 100%;
  }
</style>
