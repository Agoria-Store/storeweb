---
// Static gold coin drawn to match the WebGL coin; shown first and kept when 3D cannot run.
const ticks = Array.from({ length: 28 }, (_, i) => (i / 28) * 360);
---

<svg class="coin-svg" viewBox="0 0 200 200" aria-hidden="true">
  <defs>
    <radialGradient id="btc-face" cx="36%" cy="30%" r="80%">
      <stop offset="0" stop-color="#ffe3a1"></stop>
      <stop offset="0.45" stop-color="#e9a93a"></stop>
      <stop offset="1" stop-color="#a8681a"></stop>
    </radialGradient>
    <linearGradient id="btc-rim" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff0c4"></stop>
      <stop offset="0.45" stop-color="#d9962c"></stop>
      <stop offset="1" stop-color="#7a4a10"></stop>
    </linearGradient>
    <linearGradient id="btc-glyph" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff6d8"></stop>
      <stop offset="1" stop-color="#e2a33c"></stop>
    </linearGradient>
  </defs>
  <circle cx="100" cy="100" r="94" fill="url(#btc-rim)"></circle>
  <circle cx="100" cy="100" r="80" fill="url(#btc-face)"></circle>
  <g fill="none" stroke="#fff3cf" stroke-opacity="0.55">
    <circle cx="100" cy="100" r="77" stroke-width="1.6"></circle>
    <circle cx="100" cy="100" r="63" stroke-width="1.6"></circle>
    <circle cx="100" cy="100" r="61.5" stroke-width="0.6"></circle>
  </g>
  <g stroke="#fff3cf" stroke-opacity="0.45" stroke-width="1.2" stroke-linecap="round">
    {
      ticks.map((a) => (
        <g transform={`rotate(${a} 100 100)`}>
          <path d="M100 48 V43 h3 V39" fill="none" />
          <circle cx="100" cy="48" r="1.4" fill="#fff3cf" fill-opacity="0.45" stroke="none" />
        </g>
      ))
    }
  </g>
  <g transform="rotate(14 100 100)" fill="url(#btc-glyph)">
    <path
      fill-rule="evenodd"
      d="M80 133 L105 133 C124 133 127 104 109 101 C122 97 121 69 104 69 L80 69 Z M90 124 L104 124 C115 124 115 106 104 106 L90 106 Z M90 97 L103 97 C112 97 112 78 103 78 L90 78 Z"
    ></path>
    <rect x="83" y="60" width="5" height="11" rx="1"></rect>
    <rect x="93" y="60" width="5" height="11" rx="1"></rect>
    <rect x="83" y="131" width="5" height="11" rx="1"></rect>
    <rect x="93" y="131" width="5" height="11" rx="1"></rect>
  </g>
  <ellipse cx="74" cy="56" rx="44" ry="18" fill="#fff" opacity="0.14" transform="rotate(-28 74 56)"
  ></ellipse>
</svg>

<style>
  .coin-svg {
    width: 100%;
    height: 100%;
  }
</style>
