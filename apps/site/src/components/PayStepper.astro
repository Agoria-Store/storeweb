---
const steps = [
  {
    title: 'Choose USDT on TRC20',
    body: 'At checkout, pick USDT on the TRC20 (Tron) network. Payments on other networks are not detected automatically.',
  },
  {
    title: 'Copy the exact amount and address',
    body: 'Checkout shows the exact USDT amount and a TRC20 address made for your order. Copy both.',
  },
  {
    title: 'Send from your wallet or exchange',
    body: 'Paste the address and amount, make sure the network says TRC20, and send.',
  },
  {
    title: 'Get your course',
    body: 'When the payment is confirmed on the Tron network, you get a download link or a one-time Telegram invite.',
  },
];
---

<section id="pay" class="pay" aria-labelledby="pay-title" data-stepper>
  <div class="pin" data-stepper-pin>
    <div class="wrap layout">
      <div>
        <h2 id="pay-title" class="h2">How to pay with USDT, in four steps</h2>
        <ol class="tabs" role="tablist" aria-label="Payment steps" data-tabs>
          {
            steps.map((s, i) => (
              <li role="presentation">
                <button
                  role="tab"
                  id={`pay-tab-${i}`}
                  aria-controls={`pay-panel-${i}`}
                  aria-selected={i === 0 ? 'true' : 'false'}
                  tabindex={i === 0 ? 0 : -1}
                  type="button"
                >
                  <span class="n">{i + 1}</span>
                  <span>{s.title}</span>
                  <span class="bar" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="stage card">
        {
          steps.map((s, i) => (
            <div
              role="tabpanel"
              id={`pay-panel-${i}`}
              aria-labelledby={`pay-tab-${i}`}
              class="panel"
              data-panel
              hidden={i !== 0}
            >
              <div class="screen" aria-hidden="true">
                {i === 0 && (
                  <div class="nets">
                    <span class="net on">USDT, TRC20 (Tron)</span>
                    <span class="net off">USDT, other networks</span>
                  </div>
                )}
                {i === 1 && (
                  <div class="fields">
                    <span class="f">
                      <small>Amount</small>
                      <b>[PRICE] USDT</b>
                    </span>
                    <span class="f">
                      <small>TRC20 address</small>
                      <b>T[ADDRESS SHOWN AT CHECKOUT]</b>
                    </span>
                  </div>
                )}
                {i === 2 && (
                  <div class="send">
                    <span class="node">Your wallet</span>
                    <span class="trail" />
                    <span class="node">Order address</span>
                  </div>
                )}
                {i === 3 && (
                  <div class="access">
                    <span class="pill">Download link</span>
                    <span class="or">or</span>
                    <span class="pill">Telegram invite</span>
                  </div>
                )}
              </div>
              <h3>
                <span class="sr-only">Step {i + 1}: </span>
                {s.title}
              </h3>
              <p>{s.body}</p>
              {i === 1 && (
                <button class="btn btn-secondary" type="button" data-copy="[PRICE]">
                  <span data-copy-label>Try copying an example amount</span>
                </button>
              )}
            </div>
          ))
        }
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initStepper } from '../scripts/stepper';
  initStepper();
</script>

<style>
  .pay {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .pin {
    padding-block: clamp(80px, 11vw, 128px);
  }
  .layout {
    display: grid;
    gap: 40px;
  }
  .tabs {
    display: grid;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
  }
  [role='tab'] {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    align-items: center;
    width: 100%;
    gap: 14px;
    padding: 14px 16px;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 14px;
    background: none;
    color: var(--muted);
    font: 600 1.05rem/1.3 var(--font);
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  [role='tab']:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  [role='tab'][aria-selected='true'] {
    color: var(--ink);
    background: var(--bg);
    border-color: var(--line);
  }
  .n {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--surface-2);
    font-size: 0.9rem;
    font-weight: 650;
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  [aria-selected='true'] .n {
    background: var(--primary);
    color: #fff;
  }
  .bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--primary);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  .stage {
    position: relative;
    padding: 24px;
    min-height: 440px;
    background: var(--bg);
    box-shadow: var(--shadow-lg);
  }
  .panel {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .panel[hidden] {
    display: none;
  }
  .panel h3 {
    margin-top: 12px;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .panel p {
    color: var(--muted);
    max-width: 46ch;
  }
  .screen {
    width: 100%;
    height: 200px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background:
      radial-gradient(60% 90% at 0% 0%, var(--primary-soft), transparent 70%), var(--surface);
    border: 1px solid var(--line);
  }
  .nets,
  .fields {
    display: grid;
    gap: 10px;
    width: min(340px, 86%);
  }
  .net {
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    font-weight: 600;
  }
  .net.on {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-soft);
  }
  .net.off {
    color: var(--muted);
    text-decoration: line-through;
  }
  .f {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .f small {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .f b {
    overflow-wrap: anywhere;
  }
  .send {
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(360px, 90%);
  }
  .node,
  .pill {
    flex: none;
    padding: 10px 14px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: var(--shadow);
  }
  .trail {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--primary) 50%, transparent 0) 0 0 / 14px 2px;
    animation: dash 0.9s linear infinite;
  }
  @keyframes dash {
    to {
      background-position: 14px 0;
    }
  }
  .access {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .or {
    color: var(--muted);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: center;
    }
    .pin {
      min-height: 100vh;
      display: grid;
      align-items: center;
    }
    .stage {
      padding: 36px;
    }
  }
</style>
