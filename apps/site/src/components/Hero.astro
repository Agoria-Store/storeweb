---
import Rosette from './Rosette.astro';
import { store } from '../lib/store';

const courses = await (await store()).listProducts({ type: 'course' });
const from = Math.min(...courses.map((c) => c.priceUsdt));
const micro = 'PAY IN USDT ON THE TRC20 NETWORK ONLY '.repeat(14);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div class="note frame" data-note>
      <div class="top serial" aria-hidden="true">
        <span>SERIES TRC20</span>
        <span>USDT</span>
      </div>

      <div class="face">
        <div class="copy">
          <h1 id="hero-title">[Headline about the outcome for the learner]</h1>
          <p class="value">
            [Value line: who the courses are for and what they will be able to do.] Buy the full
            course, one chapter or a single video.
          </p>
          <div class="ctas">
            <a class="btn btn-primary" href="#courses">Browse courses</a>
            <a class="btn btn-secondary" href="#free-chapter">Get a free chapter</a>
          </div>
        </div>

        <div class="seal" data-rosette>
          <Rosette />
          <p class="denom">
            <span class="from">Full courses from</span>
            <span class="num amount">{from}</span>
            <span class="unit">USDT</span>
          </p>
        </div>
      </div>

      <p class="micro" aria-hidden="true">{micro}</p>

      <button
        class="uv-btn"
        type="button"
        data-uv-toggle
        aria-pressed="false"
        aria-controls="uv-terms"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path
            d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <span data-uv-label>Check under UV light</span>
      </button>

      <div class="uv" id="uv-terms" role="region" aria-label="Payment terms under UV light">
        <div class="uv-pattern" aria-hidden="true">{'USDT TRC20 '.repeat(160)}</div>
        <dl class="uv-terms">
          <div><dt>Currency</dt><dd>USDT only</dd></div>
          <div><dt>Network</dt><dd>TRC20 (Tron) only</dd></div>
          <div><dt>Checkout</dt><dd>Hosted by our payment partner</dd></div>
          <div><dt>Delivery</dt><dd>Download link or one-time Telegram invite</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  import { initUv } from '../scripts/uv';
  import { richMotionAllowed } from '../scripts/env';
  import { draw2d } from '../lib/guilloche';

  const note = document.querySelector<HTMLElement>('[data-note]');
  const seal = document.querySelector<HTMLElement>('[data-rosette]');
  const flat = document.querySelector<HTMLCanvasElement>('[data-rosette-2d]');
  if (note) initUv(note);

  if (note && seal && flat) {
    if (richMotionAllowed()) {
      const go = () =>
        import('../scripts/rosette-gl').then(({ mountRosette }) => {
          if (!mountRosette(seal, note)) draw2d(flat);
        });
      if ('requestIdleCallback' in window) requestIdleCallback(go, { timeout: 1200 });
      else setTimeout(go, 200);
    } else {
      draw2d(flat);
    }
  }
</script>

<style>
  .hero {
    padding: calc(var(--u) * 3) 0 calc(var(--u) * 6);
  }
  .note {
    --lx: 50%;
    --ly: 50%;
    position: relative;
    overflow: hidden;
    padding: calc(var(--u) * 3) calc(var(--u) * 3) calc(var(--u) * 7);
    background:
      radial-gradient(ellipse 60% 80% at 82% 45%, var(--paper-deep), transparent 70%), var(--paper);
  }
  .top {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
  }
  .face {
    display: grid;
    gap: calc(var(--u) * 4);
    padding-top: calc(var(--u) * 4);
  }
  h1 {
    font-size: clamp(2.6rem, 8.4vw, 5.6rem);
    font-variation-settings: 'opsz' 96;
    color: var(--green);
    max-width: 13ch;
  }
  .value {
    margin-top: calc(var(--u) * 3);
    max-width: 44ch;
    font-size: 1.15rem;
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 1.5);
    margin-top: calc(var(--u) * 4);
  }
  .seal {
    position: relative;
    width: min(100%, 420px);
    aspect-ratio: 1;
    justify-self: center;
  }
  .seal :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }
  .seal[data-live] :global(.rosette-2d) {
    display: none;
  }
  .denom {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }
  .from {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
  }
  .amount {
    font-size: clamp(3.6rem, 11vw, 6rem);
    font-variation-settings: 'opsz' 96;
    line-height: 0.95;
    color: var(--green);
  }
  .unit {
    font: 700 0.95rem/1 var(--font-body);
    letter-spacing: 0.2em;
    color: var(--red);
  }
  .micro {
    position: absolute;
    left: calc(var(--u) * 2);
    right: calc(var(--u) * 2);
    bottom: calc(var(--u) * 2);
    overflow: hidden;
    white-space: nowrap;
    font-size: 6px;
    letter-spacing: 0.08em;
    color: var(--green);
    border-top: 1px solid var(--rule);
    padding-top: 4px;
  }
  .uv-btn {
    position: absolute;
    z-index: 3;
    right: calc(var(--u) * 2);
    bottom: calc(var(--u) * 3.5);
    display: inline-flex;
    align-items: center;
    gap: var(--u);
    min-height: 40px;
    padding: 0 calc(var(--u) * 1.5);
    border: 1.5px solid var(--green);
    border-radius: 4px;
    background: var(--paper);
    color: var(--green);
    font: 700 0.85rem/1 var(--font-body);
    cursor: pointer;
  }
  .uv-btn[aria-pressed='true'] {
    background: var(--uv-ink);
    border-color: var(--uv-ink);
    color: var(--uv-ground);
  }

  /* Fluorescent layer: closed by default, revealed by the lamp. */
  .uv {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    align-content: end;
    padding-bottom: calc(var(--u) * 9);
    background: var(--uv-ground);
    color: var(--uv-ink);
    clip-path: circle(0 at var(--lx) var(--ly));
    visibility: hidden;
    transition:
      clip-path 0.6s var(--ease),
      visibility 0s 0.6s;
  }
  .uv-on .uv {
    visibility: visible;
    clip-path: circle(150% at var(--lx) var(--ly));
    transition: clip-path 0.7s var(--ease);
  }
  .uv-follow .uv {
    clip-path: circle(170px at var(--lx) var(--ly));
    transition: clip-path 0.15s linear;
  }
  .uv-pattern {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font: 700 11px/1.6 var(--font-body);
    letter-spacing: 0.3em;
    word-break: break-all;
    opacity: 0.2;
  }
  .uv-terms {
    position: relative;
    display: grid;
    gap: calc(var(--u) * 2);
    margin: 0;
    padding: calc(var(--u) * 3);
  }
  .uv-terms div {
    display: grid;
    gap: 2px;
  }
  .uv-terms dt {
    font-size: 0.8rem;
    opacity: 0.85;
  }
  .uv-terms dd {
    margin: 0;
    font: 600 clamp(1.4rem, 3.4vw, 2.2rem)/1.1 var(--font-display);
  }
  @media (min-width: 900px) {
    .note {
      padding: calc(var(--u) * 4) calc(var(--u) * 6) calc(var(--u) * 9);
    }
    .face {
      grid-template-columns: 1.55fr 1fr;
      align-items: center;
      min-height: min(62vh, 560px);
    }
    .uv {
      place-content: center;
      padding-bottom: 0;
    }
    .uv-terms {
      grid-template-columns: 1fr 1fr;
      column-gap: calc(var(--u) * 8);
    }
  }
</style>
