---
import { formatUsdt } from '@course-store/store-client';
import { store } from '../lib/store';
import CoinArt from './CoinArt.astro';

const courses = await (await store()).listProducts({ type: 'course' });
const from = Math.min(...courses.map((c) => c.priceUsdt));
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap copy">
    <p class="tag"><span class="dot"></span>Paid in USDT on TRC20</p>
    <h1 id="hero-title">[Headline about the outcome for the learner]</h1>
    <p class="value">
      [Value line: who the courses are for and what they will be able to do.] Buy the full course,
      one chapter, or a single video.
    </p>
    <div class="ctas">
      <a class="btn btn-primary" href="#courses">Browse courses</a>
      <a class="btn btn-secondary" href="#free-chapter">Watch a free chapter</a>
    </div>
    <p class="from">Full courses from <span class="price">{formatUsdt(from)}</span></p>
  </div>

  <div class="stage" data-coin>
    <CoinArt />
    <span class="shadow" aria-hidden="true"></span>
  </div>
</section>

<script>
  import { richMotionAllowed } from '../scripts/env';

  const stage = document.querySelector<HTMLElement>('[data-coin]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const hasWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };
  if (stage && hero && richMotionAllowed() && hasWebGL()) {
    // Shader compile is a long task, so it waits for the visitor's first move (or a quiet 6 s),
    // never competing with first paint. The SVG coin covers the gap.
    const events = ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'] as const;
    let started = false;
    const go = () => {
      if (started) return;
      started = true;
      events.forEach((e) => removeEventListener(e, go));
      import('../scripts/coin-gl').then(({ mountCoin }) => mountCoin(stage, hero));
    };
    const arm = () => {
      events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
      setTimeout(go, 6000);
    };
    if (document.readyState === 'complete') arm();
    else addEventListener('load', arm, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 6vw, 72px) 0 clamp(24px, 4vw, 48px);
    overflow: clip;
    isolation: isolate;
    text-align: center;
  }
  .glow {
    position: absolute;
    inset: -10% -20% auto;
    height: 120%;
    z-index: -1;
    background:
      radial-gradient(40% 35% at 50% 72%, rgb(38 161 123 / 0.22), transparent 70%),
      radial-gradient(35% 30% at 25% 30%, rgb(91 61 245 / 0.12), transparent 70%),
      radial-gradient(30% 30% at 78% 35%, rgb(255 122 198 / 0.12), transparent 70%);
  }
  .copy {
    display: grid;
    justify-items: center;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tether);
    box-shadow: 0 0 0 3px rgb(38 161 123 / 0.2);
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 14ch;
  }
  .value {
    margin-top: 24px;
    max-width: 46ch;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  .from {
    margin-top: 20px;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .stage {
    position: relative;
    width: min(64vw, 340px);
    aspect-ratio: 1;
    margin: clamp(16px, 3vw, 28px) auto 0;
  }
  .stage :global(canvas) {
    position: absolute;
    inset: -15%;
    width: 130% !important;
    height: 130% !important;
    animation: appear 0.6s var(--ease) both;
  }
  .stage[data-live] :global(.coin-svg) {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .shadow {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -6%;
    height: 10%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(19 107 80 / 0.28), transparent);
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
</style>
