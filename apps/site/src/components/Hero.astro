---
import { formatUsdt } from '@course-store/store-client';
import { store } from '../lib/store';
import CoinArt from './CoinArt.astro';

const courses = await (await store()).listProducts({ type: 'course' });
const from = Math.min(...courses.map((c) => c.priceUsdt));
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="wrap grid">
    <div class="copy">
      <p class="tag"><span class="dot"></span>Paid in USDT on TRC20</p>
      <h1 id="hero-title">[Headline about the outcome for the learner]</h1>
      <p class="value">
        [Value line: who the courses are for and what they will be able to do.] Buy the full course,
        one chapter, or a single video.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="#courses">Browse courses</a>
        <a class="btn btn-secondary" href="#free-chapter">Watch a free chapter</a>
      </div>
      <dl class="facts">
        <div>
          <dt>Full courses from</dt>
          <dd class="price">{formatUsdt(from)}</dd>
        </div>
        <div>
          <dt>Buy by</dt>
          <dd>Course, chapter or video</dd>
        </div>
        <div>
          <dt>Delivery</dt>
          <dd>Download or Telegram</dd>
        </div>
      </dl>
    </div>

    <div class="stage" data-coin>
      <span class="halo" aria-hidden="true"></span>
      <CoinArt />
      <span class="shadow" aria-hidden="true"></span>
    </div>
  </div>
</section>

<script>
  import { richMotionAllowed } from '../scripts/env';

  const stage = document.querySelector<HTMLElement>('[data-coin]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const hasWebGL = () => {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  };
  if (stage && hero && richMotionAllowed() && hasWebGL()) {
    // Shader compile is a long task, so it waits for the visitor's first move (or a quiet 6 s),
    // never competing with first paint. The SVG coin covers the gap.
    const events = ['pointermove', 'pointerdown', 'scroll', 'keydown', 'touchstart'] as const;
    let started = false;
    const go = () => {
      if (started) return;
      started = true;
      events.forEach((e) => removeEventListener(e, go));
      import('../scripts/coin-gl').then(({ mountCoin }) => mountCoin(stage, hero));
    };
    const arm = () => {
      events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
      setTimeout(go, 6000);
    };
    if (document.readyState === 'complete') arm();
    else addEventListener('load', arm, { once: true });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding: 40px 0 64px;
  }
  .grid {
    display: grid;
    gap: 24px;
    justify-items: center;
    text-align: center;
  }
  .copy {
    display: grid;
    justify-items: center;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tether);
    box-shadow: 0 0 0 3px rgb(61 122 95 / 0.2);
  }
  h1 {
    margin-top: 24px;
    font-size: clamp(2.5rem, 9vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.98;
    max-width: 13ch;
  }
  .value {
    margin-top: 20px;
    max-width: 44ch;
    font-size: 1.1rem;
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }
  .facts {
    display: grid;
    width: min(100%, 340px);
    margin: 28px 0 0;
    font-size: 0.9rem;
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-weight: 600;
  }
  .stage {
    position: relative;
    width: min(76vw, 320px);
    aspect-ratio: 1;
    isolation: isolate;
  }
  .halo {
    position: absolute;
    inset: -30%;
    z-index: -2;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, rgb(233 169 58 / 0.28), transparent 70%),
      radial-gradient(closest-side at 30% 30%, rgb(200 144 46 / 0.1), transparent 70%);
  }
  .stage :global(canvas) {
    position: absolute;
    inset: -15%;
    width: 130% !important;
    height: 130% !important;
    animation: appear 0.6s var(--ease) both;
  }
  .stage[data-live] :global(.coin-svg) {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .shadow {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: -8%;
    height: 9%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(122 74 16 / 0.3), transparent);
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }

  /* Desktop: copy and coin share the first screen. */
  @media (min-width: 1024px) {
    .hero {
      display: grid;
      align-items: center;
      min-height: calc(100svh - 64px);
      padding: 32px 0 56px;
    }
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 48px;
      justify-items: start;
      text-align: left;
    }
    .copy {
      justify-items: start;
    }
    h1 {
      font-size: clamp(3.6rem, 5.6vw, 5.75rem);
      max-width: 12ch;
    }
    .value {
      font-size: 1.2rem;
    }
    .ctas {
      justify-content: flex-start;
    }
    .facts {
      width: auto;
      grid-template-columns: repeat(3, auto);
      gap: 40px;
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
      font-size: 0.85rem;
    }
    .facts div {
      display: grid;
      gap: 2px;
      padding: 0;
      border: 0;
    }
    .stage {
      justify-self: center;
      width: min(38vw, 76svh, 540px);
    }
  }
</style>
