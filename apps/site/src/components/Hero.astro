---
// Set when real media exists: { webm, mp4, poster } under /public/media.
const heroVideo = null as null | { webm: string; mp4: string; poster: string };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="bg" aria-hidden="true">
    <div class="poster"></div>
    {
      heroVideo ? (
        <video
          class="media"
          muted
          loop
          playsinline
          preload="none"
          poster={heroVideo.poster}
          data-hero-video
        >
          <source data-src={heroVideo.webm} type="video/webm" />
          <source data-src={heroVideo.mp4} type="video/mp4" />
        </video>
      ) : (
        <canvas class="media field" data-hero-canvas />
      )
    }
    <div class="grid-lines"></div>
    <div class="vignette"></div>
  </div>

  <div class="wrap content">
    <p class="chip"><span class="dot"></span> Pay with USDT · TRC20</p>
    <h1 id="hero-title">[BOLD HEADLINE ABOUT THE OUTCOME]</h1>
    <p class="value">[SHORT VALUE LINE — who it's for and what they get.]</p>
    <div class="ctas">
      <a class="btn btn-primary" href="#courses" data-magnetic
        >Browse courses <span aria-hidden="true">→</span></a
      >
      <a class="btn btn-ghost" href="#free-chapter" data-magnetic>Get a free chapter</a>
    </div>
    <ul class="facts" aria-label="Buying options">
      <li>Full course</li>
      <li>Single chapter</li>
      <li>Single video</li>
    </ul>
  </div>
  <a class="scroll-cue" href="#courses" aria-label="Scroll to courses"><span></span></a>
</section>

<script>
  import { initHeroCanvas } from '../scripts/hero-canvas';
  import { richMotionAllowed } from '../scripts/env';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas) initHeroCanvas(canvas);

  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video && richMotionAllowed()) {
    video
      .querySelectorAll<HTMLSourceElement>('source[data-src]')
      .forEach((s) => (s.src = s.dataset.src!));
    video.load();
    video
      .play()
      .then(() => video.classList.add('on'))
      .catch(() => {});
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: 112px 0 96px;
    overflow: hidden;
    isolation: isolate;
  }
  .bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .poster,
  .media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster {
    background:
      radial-gradient(60% 50% at 20% 30%, rgb(45 212 191 / 0.28), transparent 70%),
      radial-gradient(45% 45% at 80% 25%, rgb(15 118 110 / 0.35), transparent 70%),
      radial-gradient(40% 40% at 65% 80%, rgb(245 158 11 / 0.18), transparent 70%), var(--bg);
  }
  .field {
    filter: blur(28px) saturate(120%);
    transform: scale(1.15);
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .field[data-live] {
    opacity: 1;
  }
  video.media {
    opacity: 0;
    transition: opacity 0.8s;
  }
  video.media.on {
    opacity: 0.55;
  }
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 50% 40%, #000 30%, transparent 75%);
  }
  .vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, var(--bg));
  }
  .content {
    display: grid;
    justify-items: start;
    gap: 22px;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px rgb(45 212 191 / 0.18);
  }
  h1 {
    font-size: clamp(2.6rem, 9vw, 5.6rem);
    max-width: 15ch;
    letter-spacing: -0.035em;
    background: linear-gradient(180deg, #fff 30%, #b9c6da);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .value {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    color: var(--muted);
    max-width: 46ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 0;
    margin: 18px 0 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .facts li::before {
    content: '✓';
    color: var(--teal);
    margin-right: 8px;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 26px;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--teal);
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80% {
      transform: translateY(14px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
</style>
