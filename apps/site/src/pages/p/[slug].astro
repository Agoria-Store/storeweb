---
import type { GetStaticPaths } from 'astro';
import { formatUsdt, type Product } from '@course-store/store-client';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';
import SavingsBadge from '../../components/SavingsBadge.astro';
import { store } from '../../lib/store';
import { hasDetailPage, partsOf, withSavings, TYPE_LABEL, productHref } from '../../lib/catalog';

export const getStaticPaths = (async () => {
  const all = await (await store()).listProducts();
  return all
    .filter(hasDetailPage)
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const p = await withSavings(product);
const parts = await partsOf(product);
const s = await store();
const nested = await Promise.all(parts.map((c) => s.listProducts({ parentId: c.id })));
const isBundle = p.type === 'bundle';
const partLabel = isBundle ? 'Bought separately' : `All ${parts.length} chapters separately`;
const deliveryLabel =
  p.delivery === 'telegram_channel' ? 'Private Telegram channel' : 'Expiring download link';
---

<Base title={`${p.title} — [BRAND NAME]`} description={p.description}>
  <section class="top">
    <div class="wrap layout">
      <div class="info">
        <a class="back" href="/#courses">← All products</a>
        <div class="chips">
          <span class="chip">{TYPE_LABEL[p.type]}</span>
          <span class="chip">{deliveryLabel}</span>
        </div>
        <h1>{p.title}</h1>
        <p class="lede">{p.description}</p>
        <div class="buy">
          <a class="btn btn-amber" href={p.checkoutUrl} rel="noopener" data-magnetic>
            Buy {isBundle ? 'bundle' : 'full course'} · {formatUsdt(p.priceUsdt)}
          </a>
          <SavingsBadge
            percent={p.savings}
            partsTotal={p.partsTotal}
            price={p.priceUsdt}
            label={partLabel}
          />
        </div>
        <p class="note">
          Checkout opens our payment partner's page with the exact USDT amount and TRC20 address.
        </p>
      </div>
      <div class="media"><Thumb product={p} eager /></div>
    </div>
  </section>

  <section class="section parts" aria-labelledby="parts-title">
    <div class="wrap">
      <h2 id="parts-title" class="h2">{isBundle ? 'What’s included' : 'Chapters'}</h2>
      <p class="lede">
        {
          isBundle
            ? 'Every product below is included.'
            : 'Buy any chapter on its own, or the full course to save.'
        }
      </p>
      <div class="accordion">
        {
          parts.map((c, i) => (
            <details id={c.slug} class="item" open={i === 0} data-reveal>
              <summary>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t">{c.title}</span>
                <span class="money">{formatUsdt(c.priceUsdt)}</span>
                <span class="chev" aria-hidden="true" />
              </summary>
              <div class="panel">
                <p>{c.description}</p>
                {(nested[i]?.length ?? 0) > 0 && (
                  <ul class="videos">
                    {nested[i]!.map((v) => (
                      <li>
                        <span>{v.title}</span>
                        <a href={v.checkoutUrl} rel="noopener">
                          Buy · {formatUsdt(v.priceUsdt)}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <a
                  class="btn btn-ghost"
                  href={isBundle ? productHref(c) : c.checkoutUrl}
                  rel={isBundle ? undefined : 'noopener'}
                >
                  {isBundle ? 'View details' : `Buy this chapter · ${formatUsdt(c.priceUsdt)}`}
                </a>
              </div>
            </details>
          ))
        }
      </div>
      {
        p.savings > 0 && (
          <div class="upsell" data-reveal>
            <p>
              Full {isBundle ? 'bundle' : 'course'}:{' '}
              <span class="money">{formatUsdt(p.priceUsdt)}</span> instead of{' '}
              <s>{formatUsdt(p.partsTotal)}</s> — save {p.savings}%.
            </p>
            <a class="btn btn-amber" href={p.checkoutUrl} rel="noopener" data-magnetic>
              Buy {isBundle ? 'bundle' : 'full course'}
            </a>
          </div>
        )
      }
    </div>
  </section>
</Base>

<script>
  import { initAccordion } from '../../scripts/accordion';
  initAccordion();
</script>

<style>
  .top {
    padding: 112px 0 40px;
    background: radial-gradient(60% 60% at 80% 0%, rgb(15 118 110 / 0.25), transparent 70%);
  }
  .layout {
    display: grid;
    gap: 36px;
  }
  .info {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  h1 {
    font-size: clamp(2.2rem, 6vw, 3.8rem);
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .note {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .accordion {
    display: grid;
    gap: 12px;
    margin-top: 36px;
  }
  .item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.3s;
  }
  .item[open] {
    border-color: rgb(45 212 191 / 0.35);
  }
  summary {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .n {
    font: 600 0.8rem/1 var(--font-head);
    color: var(--teal);
  }
  .t {
    font: 600 1.05rem/1.3 var(--font-head);
  }
  .chev {
    width: 10px;
    height: 10px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.3s var(--ease);
  }
  .item[open] .chev {
    transform: rotate(225deg);
  }
  .panel {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: 0 20px 20px 52px;
    color: var(--muted);
  }
  .videos {
    width: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .videos li {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  .upsell {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
    padding: 20px 24px;
    border-radius: var(--radius);
    background: rgb(245 158 11 / 0.08);
    border: 1px solid rgb(245 158 11 / 0.3);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
    }
  }
  @media (max-width: 520px) {
    summary {
      grid-template-columns: auto 1fr auto;
    }
    .chev {
      display: none;
    }
    .panel {
      padding-left: 20px;
    }
  }
</style>
