---
import type { GetStaticPaths } from 'astro';
import { formatUsdt, type Product } from '@course-store/store-client';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';
import { store } from '../../lib/store';
import { hasDetailPage, partsOf, withSavings, TYPE_LABEL, productHref } from '../../lib/catalog';

export const getStaticPaths = (async () => {
  const all = await (await store()).listProducts();
  return all
    .filter(hasDetailPage)
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}) satisfies GetStaticPaths;

const { product } = Astro.props as { product: Product };
const p = await withSavings(product);
const parts = await partsOf(product);
const s = await store();
const nested = await Promise.all(parts.map((c) => s.listProducts({ parentId: c.id })));
const isBundle = p.type === 'bundle';
const whole = isBundle ? 'bundle' : 'full course';
const partName = isBundle ? 'product' : 'chapter';
const saved = Math.round((p.partsTotal - p.priceUsdt) * 100) / 100;
const delivery =
  p.delivery === 'telegram_channel'
    ? 'Delivered as a one-time invite to a private Telegram channel'
    : 'Delivered as an expiring download link';
---

<Base title={`${p.title}: [BRAND NAME]`} description={p.description}>
  <section class="top">
    <div class="wrap">
      <a class="back" href="/#courses">All courses</a>
      <div class="note frame">
        <div class="serial line" aria-hidden="true">
          <span>SERIES TRC20</span>
          <span>{TYPE_LABEL[p.type].toUpperCase()}</span>
        </div>
        <div class="face">
          <div>
            <h1>{p.title}</h1>
            <p class="lede">{p.description}</p>
            <p class="delivery">{delivery}.</p>
            <div class="buy">
              <a class="btn btn-buy" href={p.checkoutUrl} rel="noopener">
                Buy the {whole} for {formatUsdt(p.priceUsdt)}
              </a>
              {
                parts.length > 0 && !isBundle && (
                  <a class="btn btn-secondary" href="#parts">
                    Buy single chapters
                  </a>
                )
              }
            </div>
            <p class="note-small">
              Checkout opens our payment partner's page with the exact USDT amount and TRC20
              address.
            </p>
          </div>
          <Thumb product={p} size="lg" />
        </div>
      </div>
    </div>
  </section>

  {
    p.savings > 0 && (
      <section class="change" aria-labelledby="change-title">
        <div class="wrap change-grid">
          <h2 id="change-title" class="h2">
            The {whole} saves {formatUsdt(saved)}
          </h2>
          <table class="sum">
            <caption class="sr-only">
              Price of each {partName} compared with the {whole}
            </caption>
            <tbody>
              {parts.map((c) => (
                <tr>
                  <th scope="row">{c.title}</th>
                  <td class="num">{c.priceUsdt}</td>
                </tr>
              ))}
              <tr class="total">
                <th scope="row">
                  All {parts.length} {partName}s separately
                </th>
                <td class="num">{p.partsTotal}</td>
              </tr>
              <tr class="whole">
                <th scope="row">The {whole}</th>
                <td class="num">{p.priceUsdt}</td>
              </tr>
              <tr class="saved">
                <th scope="row">You save ({p.savings}%)</th>
                <td class="num">{saved}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <section id="parts" class="section parts" aria-labelledby="parts-title">
    <div class="wrap">
      <h2 id="parts-title" class="h2">{isBundle ? 'What the bundle includes' : 'Chapters'}</h2>
      <p class="lede">
        {
          isBundle
            ? 'Every product below is included.'
            : 'Open a chapter to see what it covers, or buy it on its own.'
        }
      </p>
      <div class="accordion">
        {
          parts.map((c, i) => (
            <details id={c.slug} class="item" open={i === 0}>
              <summary>
                <span class="n num">{i + 1}</span>
                <span class="t">{c.title}</span>
                <span class="price">
                  <span class="num">{c.priceUsdt}</span> USDT
                </span>
                <svg class="chev" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
              </summary>
              <div class="panel">
                <p>{c.description}</p>
                {(nested[i]?.length ?? 0) > 0 && (
                  <ul class="videos">
                    {nested[i]!.map((v) => (
                      <li>
                        <span>{v.title}</span>
                        <a href={v.checkoutUrl} rel="noopener">
                          Buy this video for {formatUsdt(v.priceUsdt)}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {isBundle ? (
                  <a class="btn btn-secondary" href={productHref(c)}>
                    See this course
                  </a>
                ) : (
                  <a class="btn btn-secondary" href={c.checkoutUrl} rel="noopener">
                    Buy this chapter for {formatUsdt(c.priceUsdt)}
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  import { initAccordion } from '../../scripts/accordion';
  initAccordion();
</script>

<style>
  .top {
    padding: calc(var(--u) * 3) 0 calc(var(--u) * 8);
  }
  .back {
    display: inline-block;
    margin-bottom: calc(var(--u) * 2);
    color: var(--green);
    font-weight: 700;
  }
  .note {
    padding: calc(var(--u) * 3);
  }
  .line {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
  }
  .face {
    display: grid;
    gap: calc(var(--u) * 4);
    padding-top: calc(var(--u) * 3);
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 4.8rem);
    font-variation-settings: 'opsz' 96;
    color: var(--green);
  }
  .delivery {
    margin-top: calc(var(--u) * 2);
    font-weight: 700;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--u) * 1.5);
    margin-top: calc(var(--u) * 4);
  }
  .note-small {
    margin-top: calc(var(--u) * 2);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .change {
    background: var(--green);
    color: var(--on-green);
    padding-block: calc(var(--u) * 10);
  }
  .change-grid {
    display: grid;
    gap: calc(var(--u) * 5);
  }
  .change :focus-visible {
    outline-color: var(--uv-ink);
  }
  .sum {
    width: 100%;
    border-collapse: collapse;
  }
  .sum th {
    text-align: left;
    font-weight: 400;
    padding: 12px 0;
    color: var(--on-green-muted);
  }
  .sum td {
    text-align: right;
    font-size: 1.5rem;
  }
  .sum tr {
    border-bottom: 1px solid rgb(233 237 226 / 0.2);
  }
  .total th,
  .whole th {
    color: var(--on-green);
    font-weight: 700;
  }
  .total td {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .whole td {
    font-size: 2.2rem;
  }
  .saved {
    border-bottom: 0 !important;
  }
  .saved th,
  .saved td {
    color: var(--uv-ink);
    font-weight: 700;
  }
  .accordion {
    margin-top: calc(var(--u) * 5);
    border-bottom: 1px solid var(--rule);
  }
  .item {
    border-top: 1px solid var(--rule);
  }
  summary {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto auto;
    align-items: center;
    gap: calc(var(--u) * 2);
    padding: calc(var(--u) * 2.5) 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .t {
    text-decoration: underline;
  }
  .n {
    font-size: 1.6rem;
    color: var(--red);
  }
  .t {
    font: 600 1.3rem/1.2 var(--font-display);
  }
  .price {
    font-weight: 700;
    white-space: nowrap;
  }
  .price .num {
    font-size: 1.3rem;
    color: var(--green);
  }
  .chev {
    color: var(--green);
    transition: transform 0.3s var(--ease);
  }
  .item[open] .chev {
    transform: rotate(180deg);
  }
  .panel {
    display: grid;
    gap: calc(var(--u) * 2);
    justify-items: start;
    padding: 0 0 calc(var(--u) * 3) calc(2.5rem + var(--u) * 2);
    color: var(--muted);
  }
  .videos {
    width: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .videos li {
    display: flex;
    justify-content: space-between;
    padding: var(--u) 0;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 900px) {
    .note {
      padding: calc(var(--u) * 4) calc(var(--u) * 6) calc(var(--u) * 6);
    }
    .face {
      grid-template-columns: 1.4fr 1fr;
      align-items: center;
    }
    .change-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  @media (max-width: 560px) {
    summary {
      grid-template-columns: 2rem 1fr auto;
    }
    .chev {
      display: none;
    }
    .panel {
      padding-left: 0;
    }
  }
</style>
